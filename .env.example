# Provider-issued values from the dedicated Waymark Supabase project dashboard.
# Leave empty until that project exists. Never put a secret/service-role key here.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Exact site origin. Use http://localhost:3200 for local development;
# staging/production must have their own HTTPS origin and provider allowlists.
WAYMARK_SITE_URL=http://localhost:3200

# Enable only after Google is configured for this dedicated project.
WAYMARK_GOOGLE_AUTH_ENABLED=false

# Enable only after Apple Sign In is configured for this dedicated project.
WAYMARK_APPLE_AUTH_ENABLED=false

# Enable only after Apple Sign In is configured for this dedicated project.
WAYMARK_APPLE_AUTH_ENABLED=false
